# Render define PORT automáticamente; en local es opcional.
PORT=3000
# URL del frontend (Vercel), sin barra final. Varias separadas por coma.
CORS_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL (la base que levanta `docker compose up -d db` en la raíz del repo).
# Cuando el backend corre DENTRO de docker-compose, el host es "db" en vez de "localhost".
DATABASE_URL=postgres://fintrack:fintrack_dev@localhost:5432/fintrack
