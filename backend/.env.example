# Render define PORT automáticamente; en local es opcional.
PORT=3000
# URL del frontend (Vercel), sin barra final. Varias separadas por coma.
CORS_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL. En local apunta al contenedor Docker (puerto 5434)
DATABASE_URL=postgresql://fintrack:fintrack_dev@localhost:5434/fintrack
# Máximo de conexiones simultáneas del pool (opcional, por defecto 10).
# En producción, déjalo por debajo del límite de conexiones del plan de la BD.
DB_POOL_MAX=10
# Autenticación (JWT). El secreto firma los access tokens: en producción debe ser
# largo, aleatorio y distinto por entorno. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Duración del access token (formato de jsonwebtoken: 15m, 1h...) y días del refresh token.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Intentos de login/registro permitidos por IP cada 15 minutos (opcional, por defecto 20).
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30
# Cantidad de proxies delante del servidor. En local 0; en Render 1 (para leer la IP real).
TRUST_PROXY=0

# Categorización con IA (FT-0003). Sin AI_API_KEY la IA queda desactivada: las transacciones
# sin categoría se guardan como "Sin clasificar". La clave es personal: nunca se sube al repo.
# Proveedor: gemini (por defecto) o anthropic. La clave de Gemini se crea en Google AI Studio.
AI_PROVIDER=gemini
AI_API_KEY=
# Opcionales: modelo (por defecto gemini-flash-lite-latest), endpoint propio y espera máxima en ms.
# AI_MODEL=gemini-flash-lite-latest
# AI_API_URL=
AI_TIMEOUT_MS=8000

# Notificaciones push (FT-0011). Sin las dos llaves VAPID el push y el recordatorio diario quedan
# desactivados. Genera el par una sola vez con:
#   npx web-push generate-vapid-keys
# La privada es un secreto: nunca se sube al repo. La pública se entrega al navegador.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del servidor ante el servicio push del navegador (un mailto: o una URL https).
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Opcionales: apagar el recordatorio diario (false) y cada cuánto se revisa, en ms.
# REMINDERS_ENABLED=true
# REMINDER_CHECK_INTERVAL_MS=60000
# Máximo de transacciones de un lote de /sync/batch que se categorizan con IA (por defecto 20; 0 la desactiva).
SYNC_AI_MAX=20
# Inicio de sesión con Google. ID de cliente OAuth de tipo "Aplicación web" (Google Cloud Console →
# Google Auth Platform → Clientes). No es secreto, pero sin él el botón de Google no funciona.
# El mismo valor va en el frontend como VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
