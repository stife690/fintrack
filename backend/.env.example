# Render define PORT automáticamente; en local es opcional.
PORT=3000
# URL del frontend (Vercel), sin barra final. Varias separadas por coma.
CORS_ORIGIN=http://localhost:5173
# Conexión a PostgreSQL. En local apunta al contenedor Docker (puerto 5434)
DATABASE_URL=postgresql://fintrack:fintrack_dev@localhost:5434/fintrack
# Máximo de conexiones simultáneas del pool (opcional, por defecto 10).
# En producción, déjalo por debajo del límite de conexiones del plan de la BD.
DB_POOL_MAX=10
