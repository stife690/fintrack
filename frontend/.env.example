# URL pública del backend (Render). En local: http://localhost:3000
VITE_API_URL=http://localhost:3000

# Dominio público de la app para los enlaces que se comparten (invitaciones a vacas), sin barra
# final. En Vercel: https://fintrackcol.online. Vacío = el dominio en el que se abrió la app.
VITE_APP_URL=

# Solo en desarrollo: MSW simula /auth/* mientras el backend no lo tenga. "false" para usar la API real.
VITE_API_MOCKS=true

# ID de cliente OAuth de Google (tipo "Aplicación web"). No es secreto. Sin él, el botón
# "Continuar con Google" queda deshabilitado. En Vercel es la misma variable.
VITE_GOOGLE_CLIENT_ID=
